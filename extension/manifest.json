{
  "manifest_version": 3,
  "name": "BTÜ Kampüs Asistanı",
  "version": "1.0.0",
  "description": "Bursa Teknik Üniversitesi boş derslik bulucu, bölüm ve hoca haftalık ders programları.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BTÜ Kampüs Asistanı",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://omergns0.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
